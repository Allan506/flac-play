{
  "name": "flac-play",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "Buscador de música de alta fidelidad para los catálogos de Kuwo y NetEase.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"PORT=12001 node --watch server/index.mjs\" \"vite --host 0.0.0.0 --port 12000\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production PORT=12000 bash scripts/serve-prod.sh",
    "start:once": "NODE_ENV=production PORT=12000 node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 12000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:supervised": "bash scripts/serve-prod.sh"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.0.0",
    "json5": "^2.2.3",
    "lru-cache": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.30.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "allowScripts": {
    "ffmpeg-static": true
  }
}
